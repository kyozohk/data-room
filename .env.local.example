# Required: shared password for the dataroom (visitors enter this)
DATAROOM_PASSWORD=change-me-please

# Required: separate password for the /admin analytics dashboard
ADMIN_PASSWORD=change-me-admin

# Required: random secret used to sign auth cookies (generate: openssl rand -hex 32)
AUTH_SECRET=replace-with-32-byte-random-hex

# Optional: human-readable name shown in the header
DATAROOM_NAME=Kyozo Dataroom
